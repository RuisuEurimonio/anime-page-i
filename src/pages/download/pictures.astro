---
import ExpoResources from "../../components/ExpoResources";
import Layout from "../../layouts/Layout.astro";
import data from "../../data/picturesList.json"
---

<Layout
	showHeaderLinks={true}
	active="pictures"
	isSecondPage={true}
	title="Imágenes de anime | Anime Page"
	description="Explora y descarga imágenes de personajes y series utilizadas en Anime Page."
	socialImage="/downloads/capturas.jpg"
>
    <section class=" relative pt-[10vh]
     md:pt-[20vh]
    ">
        <ExpoResources 
            mainTitle={"Imagenes"}
            srcAll={"/characters/zip.zip"}
            count={data.length}
            fullView={true}
            listFullView={data}
            firstElement={null}
            secondElement={null}
            thirdElement={null}
            isVideo={false}
            client:load
        />
    </section>
</Layout>