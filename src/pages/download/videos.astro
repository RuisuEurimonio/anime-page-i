---
import ExpoResources from "../../components/ExpoResources";
import Layout from "../../layouts/Layout.astro";
import data from "../../data/videoList.json";
---

<Layout showHeaderLinks={true} active={"videos"} isSecondPage={true}>
    <section class=" relative pt-[10vh]
     md:pt-[20vh]
    ">
        <ExpoResources 
            mainTitle={"Videos"}
            srcAll={"/videos/videos.zip"}
            count={data.length}
            fullView={true}
            listFullView={data}
            firstElement={null}
            secondElement={null}
            thirdElement={null}
            isVideo={true}
            client:load
        />
    </section>
</Layout>