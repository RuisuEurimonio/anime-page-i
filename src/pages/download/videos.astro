---
import ExpoResources from "../../components/ExpoResources";
import Layout from "../../layouts/Layout.astro";
import data from "../../data/videoList.json";
---

<Layout
	showHeaderLinks={true}
	active="videos"
	isSecondPage={true}
	title="Videos y secuencias | Anime Page"
	description="Explora y descarga las secuencias de video utilizadas en las animaciones de Anime Page."
	socialImage="/downloads/videos.jpg"
>
    <section class=" relative pt-[10vh]
     md:pt-[20vh]
    ">
        <ExpoResources 
            mainTitle={"Videos"}
            srcAll={"/videos/videos.zip"}
            count={data.length}
            fullView={true}
            listFullView={data}
            firstElement={null}
            secondElement={null}
            thirdElement={null}
            isVideo={true}
            client:load
        />
    </section>
</Layout>