---
import ExpoResources from "../../components/ExpoResources";
import Layout from "../../layouts/Layout.astro";
import data from "../../data/pagesList.json"
---

<Layout showHeaderLinks={true} active={"resources"} isSecondPage={true}>
    <section class=" relative pt-[10vh]
     md:pt-[20vh]
    ">
        <ExpoResources 
            mainTitle={"Imagenes"}
            count={data.length}
            fullView={true}
            listFullView={data}
            firstElement={null}
            secondElement={null}
            thirdElement={null}
            isPage={true}
            client:load
        />
    </section>
</Layout>