---
import ExpoResources from "./ExpoResources";
---

<section>
    <div id="mainImage_download" class="relative w-full h-screen">
        <div class="mask_donwload w-full absolute top-0 left-0 h-full z-10"></div>
        <div class="absolute left-0 right-0 bottom-10 w-8/12 mx-auto z-20">
                <h1 class="text-5xl text-fuchsia-400 uppercase w-8/12 font-bold mb-4"> Explora recursos utilizados en Anime Page </h1>
                <p class="text-xl text-white"> Descubre recursos, páginas y más</p>
        </div>
    </div>
    <div>
        <ExpoResources 
            mainTitle={"Videos"}
            firstElement={{
                name: "Sailor Moon",
                imageUrl: "/frames/sailorMoon/sailor_1.png"
            }}
            secondElement={{
                name: "Mikara Ackerman",
                imageUrl: "/frames/mikasa/mikasa_13.jpg"
            }}
            thirdElement={{
                name: "Frieren",
                imageUrl: "/frames/frieren/frieren_5.jpg"
            }}
        />
    </div>
</section>

<style>
    #mainImage_download{
        background-image: url("/animeBg.jpg");
        background-repeat: no-repeat;
        background-position: center;
        background-size: cover;
    }

    .mask_donwload{
        background: #120314;
        background: linear-gradient(0deg,rgba(18, 3, 20, 1) 0%, rgba(21, 3, 19, 1) 12%, rgba(94, 4, 0, 0) 100%);
    }
</style>