---
import Header from "../components/Header.astro";
import "../../global.css";
import Footer from "../components/Footer";
import LoadingScreen from "../components/LoadingScreen"

const {
	showHeaderLinks = false,
	active = "/",
	isSecondPage = false,
	title = "Anime Page | Personajes, historias y escenas de anime",
	description = "Descubre personajes icónicos, historias, escenas y recursos de anime en una experiencia visual interactiva creada por Luis Linares.",
	socialImage = "/background.webp",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(socialImage, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<link
			rel="icon"
			type="image/x-icon"
			href={`${import.meta.env.BASE_URL}favicon.ico`}
		/>
		<link rel="canonical" href={canonicalURL} />

		<meta name="description" content={description} />
		<meta name="author" content="Luis Felipe Linares Perdomo" />

		<meta name="theme-color" content="#120314" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_CO" />
		<meta property="og:site_name" content="Anime Page" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={socialImageURL} />
		<meta
			property="og:image:alt"
			content="Vista principal de Anime Page"
		/>

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />

		<meta name="generator" content={Astro.generator} />
		<title> {title} </title>
	</head>
	<body>
	<a
		href="#main-content"
		class="fixed left-4 top-4 z-[200] -translate-y-24 rounded-full bg-white px-4 py-2 font-bold text-black transition-transform focus:translate-y-0"
	>
		Saltar al contenido principal
	</a>

	<LoadingScreen client:load />
	<Header showLinks={showHeaderLinks} active={active} />

	<main id="main-content" tabindex="-1">
		<slot />
	</main>

	<Footer isSecondPage={isSecondPage} client:visible />
</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: rgb(18,3,20)
	}

	body{
		position: relative;
	}
</style>
