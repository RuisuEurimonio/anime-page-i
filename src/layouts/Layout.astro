---
import Header from "../components/Header.astro";
import "../../global.css";
import Footer from "../components/Footer";
import LoadingScreen from "../components/LoadingScreen"

const {showHeaderLinks = false, active = "/", isSecondPage = false} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<meta name="description" content="Descubre los animes más populares y conoce a sus personajes icónicos. Explora historias, curiosidades y momentos memorables que cautivan a millones de fans en todo el mundo.">
		<meta name="generator" content={Astro.generator} />
		<title> Anime Page </title>
	</head>
	<body>
		<Header showLinks={showHeaderLinks} active={active}/>
		<slot />
		<Footer isSecondPage={isSecondPage} client:load/>
		<LoadingScreen client:load/>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: rgb(18,3,20)
	}

	body{
		position: relative;
	}
</style>
